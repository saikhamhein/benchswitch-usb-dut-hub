(version 1)
(rule "USB routing width" (condition "A.hasNetclass('USB_HS')") (constraint track_width (min 0.135635mm) (opt 0.135636mm) (max 0.135637mm)))
(rule "USB coupled geometry" (condition "A.hasNetclass('USB_HS')") (constraint diff_pair_gap (min 0.150mm) (opt 0.1524mm) (max 0.155mm)) (constraint diff_pair_uncoupled (max 13mm)) (constraint skew (within_diff_pairs) (max 0.25mm)))
(rule "USB noncoplanar clearance" (condition "A.Type == 'Track' && A.hasNetclass('USB_HS') && !AB.isCoupledDiffPair() && !(A.intersectsArea('USB_ESCAPE_CORE') || A.intersectsArea('USB_ESCAPE_UP_ESD') || A.intersectsArea('USB_ESCAPE_UP_CONNECTOR') || A.intersectsArea('USB_ESCAPE_P1_ESD') || A.intersectsArea('USB_ESCAPE_P1_CONNECTOR') || A.intersectsArea('USB_ESCAPE_P2_ESD') || A.intersectsArea('USB_ESCAPE_P2_CONNECTOR') || A.intersectsArea('USB_ESCAPE_P3_ESD') || A.intersectsArea('USB_ESCAPE_P3_CONNECTOR') || A.intersectsArea('USB_ESCAPE_P4_ESD') || A.intersectsArea('USB_ESCAPE_P4_CONNECTOR'))") (constraint clearance (min 0.5mm)))
(rule "USB package escape geometry" (condition "A.hasNetclass('USB_HS') && (A.intersectsArea('USB_ESCAPE_CORE') || A.intersectsArea('USB_ESCAPE_UP_ESD') || A.intersectsArea('USB_ESCAPE_UP_CONNECTOR') || A.intersectsArea('USB_ESCAPE_P1_ESD') || A.intersectsArea('USB_ESCAPE_P1_CONNECTOR') || A.intersectsArea('USB_ESCAPE_P2_ESD') || A.intersectsArea('USB_ESCAPE_P2_CONNECTOR') || A.intersectsArea('USB_ESCAPE_P3_ESD') || A.intersectsArea('USB_ESCAPE_P3_CONNECTOR') || A.intersectsArea('USB_ESCAPE_P4_ESD') || A.intersectsArea('USB_ESCAPE_P4_CONNECTOR'))") (constraint diff_pair_gap (min 0.127mm) (opt 0.1524mm) (max 2.0mm)))

(rule "Standard via hole clearance" (condition "A.Type == 'Via' || B.Type == 'Via'") (constraint hole_clearance (min 0.25mm)))

(rule "Standard through via drill floor" (condition "A.Type == 'Via'") (constraint hole_size (min 0.30mm)))
(rule "Preserve component drilled-pad hole clearance" (condition "(A.Type == 'Pad' && (A.Pad_Type == 'Through-hole' || A.Pad_Type == 'NPTH, mechanical')) || (B.Type == 'Pad' && (B.Pad_Type == 'Through-hole' || B.Pad_Type == 'NPTH, mechanical'))") (constraint hole_clearance (min 0.30mm)))
